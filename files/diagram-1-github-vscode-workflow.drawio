  <diagram id="d1-monitor" name="1.7 Backup &amp; Monitoring">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t" value="1.7 &#8212; Backup &amp; Monitoring (target state)" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="700" height="40" as="geometry" />
        </mxCell>
        <mxCell id="db" value="&#9729;&#65039;&#8205;Supabase&#10;Postgres" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#134e4a;strokeColor=#2dd4bf;fontColor=#ffffff;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="140" width="180" height="90" as="geometry" />
        </mxCell>
        <mxCell id="snap" value="&#128190;&#8205;Daily snapshot&#10;Retention: 7 days&#10;Covers ALL user data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#78350f;strokeColor=#fbbf24;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="360" y="130" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="scr" value="&#129514;&#8205;Scratch DB&#10;restore drill" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="680" y="135" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="heal" value="&#10084;&#65039;&#8205;GET /health&#10;200 + commit sha&#10;+ database check" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#14532d;strokeColor=#4ade80;fontColor=#ffffff;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="290" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="alert" value="&#128680;&#8205;Error-rate alert&#10;(Sprint 3 target)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7f1d1d;strokeColor=#f87171;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="680" y="290" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="up" value="&#9201;&#65039;&#8205;External uptime check&#10;every 5 minutes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="290" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="logs" value="&#128203;&#8205;Logs&#10;Structured, one line per request, with a request id.&#10;No personal data, no secrets. Searchable retention." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="980" y="200" width="330" height="90" as="geometry" />
        </mxCell>

        </mxCell>
        <mxCell id="e5" value="monitor" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="up" target="heal">
          <mxGeometry relative="1" as="geometry" />

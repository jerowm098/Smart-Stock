          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="warn" value="&#9888;&#65039; HINDI PA IMPLEMENTED:&#10;&#8226; Walang /health route&#10;&#8226; Walang automated backup / snapshot schedule&#10;&#8226; Walang alerting&#10;&#8226; Walang external uptime check&#10;Ito ang TARGET state na dapat gawin bago mag-Production." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontSize=13;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="430" width="600" height="140" as="geometry" />
        </mxCell>
        <mxCell id="er" value="&#128274;&#8205; Erasure obligation&#10;&#10;Ang 7-day snapshot window at 7-day erasure obligation ay magkasalungat. Isang account na binura ngayon, nandoon pa rin sa snapshots ng isang linggo &#8212; kaya&#8217;t &#8220;within seven days&#8221; ang sinulat sa requirement, hindi &#8220;immediately&#8221;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;fontSize=12;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="680" y="430" width="630" height="140" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>

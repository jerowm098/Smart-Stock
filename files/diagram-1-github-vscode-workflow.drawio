        </mxCell>
        <mxCell id="quote" value="&#8220;One artifact, built once, promoted unchanged. A final release deploys the same bytes that were on Test all sprint. If Test and Production needed different builds, an environment difference has leaked into the code.&#8221;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontStyle=2;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1080" y="370" width="600" height="120" as="geometry" />
        </mxCell>
        <mxCell id="quote2" value="&#8220;A deploy that does not verify itself is one you hear about from a student on Saturday morning.&#8221;&#10;&#10;&#8220;An untested restore is a belief, not a backup.&#8221;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;fontSize=12;fontStyle=2;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1080" y="510" width="600" height="100" as="geometry" />
        </mxCell>

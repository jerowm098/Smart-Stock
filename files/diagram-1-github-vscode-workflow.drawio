          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="restore tested&#10;once, before Sprint 2 review" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="snap" target="scr">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="db" target="heal">

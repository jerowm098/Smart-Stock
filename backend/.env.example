APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# DATABASE
# Production: Supabase PostgreSQL (pgsql). Local development: XAMPP MariaDB.
# Kunin sa Supabase Dashboard > Project Settings > Database > Connection string.
# Pindutin ang Connect button sa taas > Transaction Pooler > URI tab.
# Huwag i-type ng mano-mano, i-copy paste ang host/port/user.
#
# MODE 0 - LOCAL XAMPP MariaDB:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=smartstock_db
# DB_USERNAME=root
# DB_PASSWORD=
#
# MODE A - DIRECT (pang-migrate, IPv6-ready network lang):
# DB_HOST=db.xxxxx.supabase.co
# DB_PORT=5432
# DB_USERNAME=postgres
#
# MODE B - POOLER (pang-Globe IPv4 / pang-prod Render):
# DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
# DB_PORT=6543
# DB_USERNAME=postgres.xxxxx (may tuldok + project ref!)
#
# Common error: tenant/user postgres.xxxxx not found = maling host/user
# combo o paused ang project. Kopyahin ulit mula sa Connect modal.
DB_CONNECTION=pgsql
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=6543
DB_DATABASE=postgres
DB_USERNAME=postgres.xxxxx
DB_PASSWORD=ilalagay_mo_dito_wag_i-commit
DB_SSLMODE=require

# Read-only Supabase source for `php artisan db:copy-from-supabase`.
# Kapareho ng DB_* sa itaas pero may SUPABASE_ prefix para hindi magulo
# kapag naka-MySQL ang LOCAL DB_CONNECTION.
# SUPABASE_DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
# SUPABASE_DB_PORT=6543
# SUPABASE_DB_DATABASE=postgres
# SUPABASE_DB_USERNAME=postgres.xxxxx
# SUPABASE_DB_PASSWORD=ilalagay_mo_dito_wag_i-commit
# SUPABASE_DB_SSLMODE=require

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Google Gemini — AI product field suggestions (server-side only, never expose to frontend)
# Get a key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Ordered fallback chain (first = primary). Comma-separated.
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemma-4-26b-a4b-it,gemma-4-31b-it
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

        <mxCell id="note1" value="&#128274;&#8205; MULTI-TENANT: Ang products, suppliers, sales, stock_ins, stock_adjustments at order_suggestions ay may user_id &#8212; scope ng bawat account.&#10;&#128274;&#8205; SKU uniqueness: unique PER USER (hindi globally) &#8212; migration: make_sku_unique_per_user&#10;&#10003;&#8205; protect_history_from_user_cascade_delete: kapag tinanggal ang user, PRESERVED ang sales / stock history." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;fontSize=12;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="380" y="620" width="1060" height="110" as="geometry" />
        </mxCell>

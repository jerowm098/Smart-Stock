        <mxCell id="portWarn" value="&#9888;&#65039; PORT 6543 = Transaction-mode pooler, HINDI 5432 (direct connection).&#10;&#10;Mula sa PDF: &#8220;Free tier caps connections &#8212; use a connection pool; do not open one per request.&#8221;&#10;Ang pooler ang nag-iisang layer na nagsasagawa ng pooling. Ito ang tamang setup." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;fontSize=12;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1340" y="100" width="320" height="180" as="geometry" />

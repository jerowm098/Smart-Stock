        <mxCell id="h1" value="09_30_000001&#10;add_is_active&#10;(users)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#059669;fontSize=11;" vertex="1" parent="gs">
          <mxGeometry x="230" y="40" width="165" height="55" as="geometry" />
        </mxCell>
        <mxCell id="h2" value="09_30_000002&#10;add_is_active&#10;(products)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#059669;fontSize=11;" vertex="1" parent="gs">
          <mxGeometry x="415" y="40" width="165" height="55" as="geometry" />
        </mxCell>
        <mxCell id="h3" value="09_30_000003&#10;create_order&#10;_suggestions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#059669;fontSize=11;" vertex="1" parent="gs">
          <mxGeometry x="600" y="40" width="165" height="55" as="geometry" />
        </mxCell>
        <mxCell id="h4" value="09_30_000004&#10;protect_history_from&#10;_user_cascade_delete" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#059669;fontSize=10;fontStyle=1;" vertex="1" parent="gs">
          <mxGeometry x="45" y="115" width="330" height="55" as="geometry" />
        </mxCell>
        <mxCell id="warn" value="&#9888;&#65039; MIGRATION ORDERING GOTCHA&#10;&#10;Ang timestamps ay HINDI chronological sa pinakahuling batch &#8212; 2026_09_21_* (add_user_id) lumagpas sa 2026_09_23_* (create_sales).&#10;Laging tingnan ang FILENAME, hindi ang dami o ang dami ng commits." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontSize=13;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="540" width="800" height="110" as="geometry" />
        </mxCell>
        <mxCell id="safe" value="&#10003;&#8205; SAFE PATTERN (mula sa PDF)&#10;&#8220;A destructive change is split in two: release n stops using the column, release n+1 drops it.&#8221;&#10;&#10;protect_history_from_user_cascade_delete &#8212; pinoprotektahan ang historical records (sales, stock_adjustments) kapag tinanggal ang user. Iyan ang tamang pattern." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;fontSize=12;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="880" y="580" width="800" height="110" as="geometry" />
        </mxCell>
        <mxCell id="rule2" value="&#128274;&#8205; RULES (mula sa PDF):&#10;&#8226; Every schema change is a REVIEWED FILE in the repository.&#10;&#8226; No hand-edited databases, ever &#8212; kahit sa Test.&#10;&#8226; Migrations run against an EMPTY database on every CI run.&#10;&#8226; Applied by the pipeline BEFORE the new code starts, never by a person.&#10;&#8226; Backwards-compatible for one release." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="720" width="1640" height="130" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

{
    "name": "smart-stock",
    "private": true,
    "description": "Workspace runner: backend/ = Laravel API, frontend/ = React SPA.",
    "scripts": {
        "dev": "npm --prefix frontend run dev",
        "dev:backend": "cd backend && php artisan serve --host=127.0.0.1 --port=8000",
        "dev:blade": "npm --prefix backend run dev",
        "build:spa": "npm --prefix frontend run build",
        "build:blade": "npm --prefix backend run build"
    }
}

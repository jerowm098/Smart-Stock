# ------------------------------------------------------------------
# .dockerignore - mga file na HINDI isasama sa Docker build context
# Database: Supabase PostgreSQL only (walang SQLite file).
# ------------------------------------------------------------------

# Git
.git
.gitignore
.gitattributes

# Environment - ITO ANG PINAKAMAHALAGA (huwag isama ang .env!)
.env
.env.*
!.env.example

# PHP dependencies (bubuo ng container)
/vendor

# Node / frontend
/node_modules
/public/build
/public/hot
npm-debug.log*

# Laravel storage & caches (magre-generate sa runtime)
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/logs/*
!/storage/framework/cache/.gitignore
!/storage/framework/sessions/.gitignore
!/storage/framework/views/.gitignore
!/storage/logs/.gitignore

# Supabase only: walang local sqlite file na isasama
/database/*.sqlite
/database/*.sqlite-journal

# Tests & ci
/tests
/phpunit.xml
.phpunit.cache
.phpunit.result.cache

# IDE & OS
.vscode
.idea
.fleet
.nova
.zend
*.log
.DS_Store

# Misc
Thumbs.db
Homestead.json
Homestead.yaml
auth.json

*.pdf
myFiles/
.venv
*.mp4
plans/
tmp_extract.py
tmp_frames/
tests/
.vs
.vscode